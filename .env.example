# ==========================================================================
# Clinical RAG Backend - environment configuration example
# Copy to .env and adjust for your intranet deployment.
# ==========================================================================

# --- Knowledge base ---
KB_SEGMENTS_PATH=./data/segments.jsonl
INDEX_DIR=./runtime/index

# --- Runtime ---
RUNTIME_DIR=./runtime

# --- Retrieval: threshold gate & fusion weights ---
THETA=0.75
K_DENSE=8
K_SPARSE=20
K_FUSED=8
W_DENSE=0.65
W_SPARSE=0.35
GUIDELINE_BOOST=1.25

# --- Dense embeddings (single multilingual encoder; runs locally) ---
# bge-m3 natively supports both Chinese and English.
DENSE_EMBED_MODEL=BAAI/bge-m3
DENSE_DEVICE=cpu

# --- Local LLM (DeepSeek-R1 intranet service; MUST be an intranet endpoint) ---
DEEPSEEK_BASE_URL=http://localhost:9000
DEEPSEEK_API_KEY=

# --- Prompt constraints ---
FIXED_CLINICAL_CONTEXT=patients scheduled for radical prostatectomy for prostate cancer
MAX_WORDS=500
MAX_TOKENS=900
TEMPERATURE=0.2

# --- External retrieval gateway (threshold-gated, outbound-only, OFF by default) ---
# Enabled only when local retrieval is insufficient. Only the de-identified,
# abstracted query is transmitted; results are filtered to the allowlist below.
ENABLE_EXTERNAL_GATEWAY=false
EXTERNAL_GATEWAY_URL=http://localhost:9100/search
EXTERNAL_K=3
EXTERNAL_TTL_SECONDS=600
# Curated allowlist of vetted external medical sources (comma-separated hosts).
EXTERNAL_SOURCE_ALLOWLIST=pubmed.ncbi.nlm.nih.gov,ncbi.nlm.nih.gov,guidelines.gov,nccn.org,uroweb.org

# --- Admin ---
ADMIN_TOKEN=
